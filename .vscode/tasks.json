{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "pnpm: watch",
            "dependsOn": [
                "pnpm: watch:tsc",
                "pnpm: watch:esbuild"
            ],
            "presentation": { "reveal": "never" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "command": "pnpm run watch:esbuild",
            "label": "pnpm: watch:esbuild",
            "isBackground": true,
            "problemMatcher": {
                "owner": "esbuild",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[watch\\] build started",
                    "endsPattern": "^\\[watch\\] build finished"
                },
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+): error: (.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            },
            "presentation": { "group": "watchers", "reveal": "never" }
        },
        {
            "type": "shell",
            "command": "pnpm run watch:tsc",
            "label": "pnpm: watch:tsc",
            "isBackground": true,
            "problemMatcher": "$tsc-watch",
            "presentation": { "group": "watchers", "reveal": "never" }
        }
    ]
}